# Copy this file to .env and set a password to enable the one-time login gate
# on the web daemon. Leave it unset (or delete .env) to run without a login screen.
NHDL_PASSWORD=

# Optional: change the port the web daemon listens on (default 8080)
# PORT=8080

# Optional: PostgreSQL centralized database connection URL.
# If unset or empty, NHDL defaults to local SQLite at data/nhdl.db.
# DATABASE_URL=postgres://nhdl_user:secret_password@localhost:5432/nhdl

# Optional: PostgreSQL test database connection URL for running cross-DB tests.
# TEST_DATABASE_URL=postgres://nhdl_user:secret_password@localhost:5432/nhdl_test
